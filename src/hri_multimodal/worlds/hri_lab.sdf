<?xml version="1.0"?>
<sdf version="1.8">
  <world name="hri_lab">
    <physics name="physics" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.16 0.2 0.26 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>4 3 8 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.3 -0.3 -1</direction><cast_shadows>true</cast_shadows></light>
    <gui fullscreen="false">
      <camera_pose>10 -5 9 0 0.65 2.25</camera_pose>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="MinimalScene" name="3D View"><ignition-gui><title>HRI lab</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></ignition-gui><engine>ogre2</engine><scene>scene</scene><camera_pose>10 -5 9 0 0.65 2.25</camera_pose></plugin>
      <plugin filename="WorldControl" name="World control"><ignition-gui><property type="string" key="state">floating</property></ignition-gui><play_pause>true</play_pause><step>true</step><start_paused>false</start_paused></plugin>
    </gui>
    <model name="floor"><static>true</static><pose>4 3 0 0 0 0</pose><link name="floor">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>8 6</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>8 6</size></plane></geometry><material><ambient>0.73 0.8 0.84 1</ambient><diffuse>0.73 0.8 0.84 1</diffuse></material></visual>
    </link></model>
    <model name="walls"><static>true</static>
      <link name="west"><pose>0 3 .25 0 0 0</pose><collision name="collision"><geometry><box><size>.1 6 .5</size></box></geometry></collision><visual name="visual"><geometry><box><size>.1 6 .5</size></box></geometry><material><ambient>.15 .28 .36 1</ambient><diffuse>.15 .28 .36 1</diffuse></material></visual></link>
      <link name="east"><pose>8 3 .25 0 0 0</pose><collision name="collision"><geometry><box><size>.1 6 .5</size></box></geometry></collision><visual name="visual"><geometry><box><size>.1 6 .5</size></box></geometry><material><ambient>.15 .28 .36 1</ambient><diffuse>.15 .28 .36 1</diffuse></material></visual></link>
      <link name="south"><pose>4 0 .25 0 0 0</pose><collision name="collision"><geometry><box><size>8 .1 .5</size></box></geometry></collision><visual name="visual"><geometry><box><size>8 .1 .5</size></box></geometry><material><ambient>.15 .28 .36 1</ambient><diffuse>.15 .28 .36 1</diffuse></material></visual></link>
      <link name="north"><pose>4 6 .25 0 0 0</pose><collision name="collision"><geometry><box><size>8 .1 .5</size></box></geometry></collision><visual name="visual"><geometry><box><size>8 .1 .5</size></box></geometry><material><ambient>.15 .28 .36 1</ambient><diffuse>.15 .28 .36 1</diffuse></material></visual></link>
    </model>
    <model name="caller"><static>true</static><pose>2 4 0 0 0 0</pose><link name="person">
      <visual name="body_visual"><pose>0 0 .6 0 0 0</pose><geometry><cylinder><radius>.16</radius><length>.8</length></cylinder></geometry><material><ambient>1 .58 .14 1</ambient><diffuse>1 .58 .14 1</diffuse></material></visual>
      <visual name="head"><pose>0 0 1.15 0 0 0</pose><geometry><sphere><radius>.16</radius></sphere></geometry><material><ambient>1 .82 .54 1</ambient><diffuse>1 .82 .54 1</diffuse></material></visual>
      <visual name="target"><pose>0 0 .01 0 0 0</pose><geometry><cylinder><radius>.4</radius><length>.02</length></cylinder></geometry><material><ambient>.9 .7 .2 1</ambient><diffuse>.9 .7 .2 1</diffuse></material></visual>
    </link></model>
    <model name="hri_robot"><pose>1.2 1.2 0 0 0 0</pose>
      <link name="chassis"><pose>0 0 .22 0 0 0</pose><inertial><mass>3</mass><inertia><ixx>.04</ixx><iyy>.06</iyy><izz>.08</izz></inertia></inertial>
        <collision name="body"><geometry><box><size>.45 .32 .18</size></box></geometry></collision>
        <visual name="body_visual"><geometry><box><size>.45 .32 .18</size></box></geometry><material><ambient>.03 .65 .58 1</ambient><diffuse>.03 .65 .58 1</diffuse></material></visual>
        <visual name="front"><pose>.2 0 .105 0 0 0</pose><geometry><box><size>.04 .25 .03</size></box></geometry><material><ambient>1 .2 .15 1</ambient><diffuse>1 .2 .15 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 .13 0 0 0</pose><geometry><cylinder><radius>.09</radius><length>.08</length></cylinder></geometry><material><ambient>.12 .2 .3 1</ambient><diffuse>.12 .2 .3 1</diffuse></material></visual>
      </link>
      <link name="left_wheel"><pose>0 .21 .1 1.57079632679 0 0</pose><inertial><mass>.3</mass><inertia><ixx>.0008</ixx><iyy>.0008</iyy><izz>.0015</izz></inertia></inertial>
        <collision name="wheel"><geometry><cylinder><radius>.1</radius><length>.05</length></cylinder></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="wheel_visual"><geometry><cylinder><radius>.1</radius><length>.05</length></cylinder></geometry><material><ambient>.05 .07 .09 1</ambient><diffuse>.05 .07 .09 1</diffuse></material></visual>
      </link>
      <link name="right_wheel"><pose>0 -.21 .1 1.57079632679 0 0</pose><inertial><mass>.3</mass><inertia><ixx>.0008</ixx><iyy>.0008</iyy><izz>.0015</izz></inertia></inertial>
        <collision name="wheel"><geometry><cylinder><radius>.1</radius><length>.05</length></cylinder></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="wheel_visual"><geometry><cylinder><radius>.1</radius><length>.05</length></cylinder></geometry><material><ambient>.05 .07 .09 1</ambient><diffuse>.05 .07 .09 1</diffuse></material></visual>
      </link>
      <joint name="left_joint" type="revolute"><parent>chassis</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <joint name="right_joint" type="revolute"><parent>chassis</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
      <link name="front_caster"><pose>.17 0 .05 0 0 0</pose><inertial><mass>.05</mass><inertia><ixx>.00005</ixx><iyy>.00005</iyy><izz>.00005</izz></inertia></inertial><collision name="caster"><geometry><sphere><radius>.05</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision><visual name="caster_visual"><geometry><sphere><radius>.05</radius></sphere></geometry></visual></link>
      <link name="rear_caster"><pose>-.17 0 .05 0 0 0</pose><inertial><mass>.05</mass><inertia><ixx>.00005</ixx><iyy>.00005</iyy><izz>.00005</izz></inertia></inertial><collision name="caster"><geometry><sphere><radius>.05</radius></sphere></geometry><surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision><visual name="caster_visual"><geometry><sphere><radius>.05</radius></sphere></geometry></visual></link>
      <joint name="front_caster_joint" type="fixed"><parent>chassis</parent><child>front_caster</child></joint>
      <joint name="rear_caster_joint" type="fixed"><parent>chassis</parent><child>rear_caster</child></joint>
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_joint</left_joint><right_joint>right_joint</right_joint><wheel_separation>.42</wheel_separation><wheel_radius>.1</wheel_radius>
        <topic>/hri/gazebo/cmd_vel</topic><odom_topic>/hri/gazebo/odom</odom_topic><odom_publish_frequency>50</odom_publish_frequency>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
        <min_linear_velocity>-.65</min_linear_velocity><max_linear_velocity>.65</max_linear_velocity>
        <min_angular_velocity>-1.8</min_angular_velocity><max_angular_velocity>1.8</max_angular_velocity>
      </plugin>
    </model>
  </world>
</sdf>
